# Cloudflare Pages 部署
CLOUDFLARE_API_TOKEN=
# 需要以下权限：Cloudflare Pages:Edit、Workers Scripts:Edit、Account Settings:Read、Access:Apps:Edit
# 获取地址：https://dash.cloudflare.com/profile/api-tokens

CLOUDFLARE_ACCOUNT_ID=
# 获取地址：https://dash.cloudflare.com → 右侧栏 → Account ID

# Google Analytics（可选）
GA_MEASUREMENT_ID=
# Google Analytics 4 Measurement ID，如 G-XXXXXXXXXX
# 填入后取消 index.html 中对应的注释块即可启用

# 后端服务（未来接入）
SUPABASE_URL=
SUPABASE_ANON_KEY=
EMAIL_SERVICE_API_KEY=